{
  opts = {
    updatetime = 50;

    number = true;
    relativenumber = true;

    tabstop = 2;
    softtabstop = 2;
    shiftwidth = 2;
    expandtab = true;

    smartindent = true;
    autoindent = true;

    wrap = false;

    foldlevel = 99;
    foldlevelstart = 99;
    foldenable = true;

    incsearch = true;
    hlsearch = true;

    termguicolors = true;
    winborder = "rounded";

    scrolloff = 8;

    ignorecase = true;
    smartcase = true;
    wildmode = "list:longest";

    colorcolumn = "80";

    swapfile = false;
    backup = false;
    undofile = true; # build-in persistent undo
  };
}
